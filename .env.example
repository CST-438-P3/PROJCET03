# Optional for local runs: copy to .env (git-ignored) and docker compose reads it.
# Never commit real values. Leave a line empty to use the local default.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
# Set SPRING_PROFILES_ACTIVE=pet-provider to use live Rescue Groups data.
RESCUE_GROUPS_API_KEY=
PUBLIC_NEARBY=true
