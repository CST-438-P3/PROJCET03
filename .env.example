# Optional for local runs: copy to .env (git-ignored) and docker compose reads it.
# Never commit real values. Leave a line empty to use the local default.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
# Live pet search: set SPRING_PROFILES_ACTIVE=pet-provider and your Rescue Groups key.
# Leave both empty to use the 3 built-in sample pets.
SPRING_PROFILES_ACTIVE=
RESCUE_GROUPS_API_KEY=
